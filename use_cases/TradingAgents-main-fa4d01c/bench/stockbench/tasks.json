      "UNDERWEIGHT": "sell_partial",
      "SELL": "sell"
    }
  },
  "flush_window": {
    "enabled": true,
    "frequency_days": 5,
    "description": "For memory-on, force outcome-aware reflections after the next available trading day so small windows can surface memory effects."
  },
  "sessions": [
    {
      "order": 1,
      "seed": 42
    }
  ]
