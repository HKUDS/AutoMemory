          },
          {
            "session": {
              "id": "ses-prod-archive-update",
              "projectID": "proj-memory",
              "title": "Final billing retry finding",
              "time": { "created": 1700100600000, "updated": 1700100800000 }
            },
            "messages": [
              {
                "role": "assistant",
                "parts": [
                  { "type": "text", "text": "Final outcome: idempotency keys fixed invoice retry duplication." }
                ]
              }
            ]
          }
        ]
      },
      "read_input": {},
      "expected_output": {
        "value": "^(?![\\s\\S]*Initial incorrect billing guess)(?![\\s\\S]*Redis TTL drift)[\\s\\S]*idempotency keys[\\s\\S]*$",
        "matcher": "regex"
